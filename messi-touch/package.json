{
  "name": "messi-touch",
  "version": "1.0.0",
  "private": true,
  "description": "The Touch: a 60 s vector film (Remotion). A 39-year-old sprints after a ball, runs backwards through his eras, and his last touch match-cuts to a boy in Rosario.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Film out/messi-touch.mp4",
    "render:scene1": "remotion render Scene1 out/scene1.mp4",
    "render:scene4": "remotion render Scene4 out/scene4.mp4",
    "stills": "node tools/stills.mjs",
    "matchcut": "node tools/matchcut-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/paths": "4.0.529",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.529",
    "@remotion/renderer": "^4.0.529",
    "@types/react": "19.1.12",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
